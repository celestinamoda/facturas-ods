---
// src/pages/index.astro
import App from '../components/App.tsx';
import '../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="es" class="scheme-light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Celestina · Registro de ventas</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
    <meta name="theme-color" content="#fad4c1" />
    {/* sw.js solo existe en la compilación (lo genera pwa/integration.mjs) */}
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ sw: `${base}sw.js` }}>
        if ('serviceWorker' in navigator) window.addEventListener('load', () => navigator.serviceWorker.register(sw));
      </script>
    )}
  </head>
  <body class="bg-bg font-sans text-sm leading-[1.45] text-ink antialiased print:bg-white">
    <App client:only="preact" />
    <noscript>Esta página necesita JavaScript.</noscript>
  </body>
</html>
